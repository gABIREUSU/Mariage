rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function dataValida(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- usuários (perfil; a senha vive no Firebase Auth) ----------
    match /usuarios/{uid} {
      allow read: if logado();
      allow create, update: if logado()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['idUsuario', 'nome', 'email'])
        && request.resource.data.keys().hasAll(['idUsuario', 'nome', 'email'])
        && request.resource.data.idUsuario == uid
        && texto(request.resource.data.nome, 1, 120)
        && texto(request.resource.data.email, 3, 160);
      allow delete: if false; // exclusão de usuário será decidida na fase 2d
    }

    // ---------- clientes (os noivos) ----------
    match /clientes/{idCliente} {
      allow read: if logado();
      allow create, update: if logado()
        && request.resource.data.keys().hasOnly(['idCliente', 'nomeNoiva', 'nomeNoivo', 'email', 'telefone'])
        && request.resource.data.keys().hasAll(['idCliente', 'nomeNoiva', 'nomeNoivo', 'email', 'telefone'])
        && request.resource.data.idCliente == idCliente
        && texto(request.resource.data.nomeNoiva, 1, 120)
        && texto(request.resource.data.nomeNoivo, 1, 120)
        && texto(request.resource.data.email, 3, 160)
        && texto(request.resource.data.telefone, 8, 20);
      allow delete: if logado();
    }

    // ---------- eventos ----------
    match /eventos/{idEvento} {
      allow read: if logado();
      allow create, update: if logado()
        && request.resource.data.keys().hasOnly(['idEvento', 'idCliente', 'idUsuario', 'data', 'horario', 'endereco', 'observacao', 'status'])
        && request.resource.data.keys().hasAll(['idEvento', 'idCliente', 'idUsuario', 'data', 'horario', 'endereco', 'observacao', 'status'])
        && request.resource.data.idEvento == idEvento
        && texto(request.resource.data.idCliente, 1, 100)
        && texto(request.resource.data.idUsuario, 1, 100)
        && dataValida(request.resource.data.data)
        && request.resource.data.horario is string
        && request.resource.data.horario.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && texto(request.resource.data.endereco, 1, 300)
        && request.resource.data.observacao is string
        && request.resource.data.observacao.size() <= 1000
        && request.resource.data.status in ['agendado', 'concluido', 'cancelado'];
      allow delete: if logado();
    }

    // ---------- agenda: um documento por dia ocupado (regra "um evento por dia") ----------
    match /agenda/{dia} {
      allow read: if logado();
      allow create: if logado()
        && dataValida(dia)
        && request.resource.data.keys().hasOnly(['data', 'idEvento'])
        && request.resource.data.keys().hasAll(['data', 'idEvento'])
        && request.resource.data.data == dia
        && texto(request.resource.data.idEvento, 1, 100);
      allow delete: if logado();
      allow update: if false; // a trava não muda de dono: apaga e cria de novo
    }

    // todo o resto: negado por padrão
  }
}